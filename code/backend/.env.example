SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# UserEntity dedicado — deve bater com MYSQL_USER e MYSQL_PASSWORD do db/.env
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/studentCoin123
SPRING_DATASOURCE_USERNAME=studentCoin123
SPRING_DATASOURCE_PASSWORD=studentCoin123
spring.jpa.properties.hibernate.jdbc.time_zone=America/Sao_Paulo

JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75 -Djava.security.egd=file:/dev/./urandom -Dspring.backgroundpreinitializer.ignore=true