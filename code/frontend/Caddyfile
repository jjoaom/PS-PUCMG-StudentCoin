  root * /usr/share/caddy
  encode gzip

  handle /api/* {
    reverse_proxy http://backend:8080
  }

  handle {
    try_files {path} /index.html
    file_server
  }

  header {
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer-when-downgrade"
    Content-Security-Policy "default-src 'self'; connect-src 'self' https://viacep.com.br; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
  }
}