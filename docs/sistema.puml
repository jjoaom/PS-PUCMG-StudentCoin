@startuml
title Diagrama de Arquitetura

left to right direction

skinparam rectangle {
  RoundCorner 15
}

node "Virtual Private Cloud" {

  rectangle "Docker Compose Environment" {

    node "Container: Frontend" {

      rectangle "Caddy\nReverse Proxy / Web Server\nPorts 80/443" as caddy

      rectangle "React App\n(Vite Build)" as react

      caddy --> react : serve static files
    }

    node "Container: Backend (Kotlin)\nPort 8080" {

      rectangle "REST API\nControllers / Services" as api

      rectangle "Business Layer\nDomain Services" as domain

      rectangle "Persistence Layer\nRepositories" as repo

      api --> domain
      domain --> repo
    }

    node "Container: RabbitMQ\nPort 5672" {

      queue "Message Broker" as mq
    }

    node "Container: PostgreSQL\nPort 5432" {

      database "PostgreSQL Database" as db
    }

    caddy --> api : HTTP/REST JSON

    api --> mq : publish/consume events

    repo --> db : JDBC / SQL
  }
}

cloud "Internet" as internet

internet --> caddy : HTTPS

@enduml